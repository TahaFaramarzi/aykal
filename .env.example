# ============================================================
# ایکال (aykal): تنها فایل تنظیمات پروژه
#   cp .env.example .env   ← بعد مقدارها را پر کنید
# ============================================================

# ---------- Meta / Instagram (تنها بخشی که از بیرون لازم دارید) ----------
# App Secret برنامه‌ی Meta (Meta for Developers ← App settings ← Basic)
META_APP_SECRET=
# یک رشته‌ی دلخواه و سخت‌حدس؛ همین را در داشبورد Meta هنگام ثبت Webhook هم وارد می‌کنید
WEBHOOK_VERIFY_TOKEN=
# توکن دسترسی حساب حرفه‌ای اینستاگرام (برای ارسال پاسخ)
IG_ACCESS_TOKEN=
# شناسه‌ی حساب حرفه‌ای اینستاگرام شما
IG_USER_ID=
INSTAGRAM_API_VERSION=v25.0

# ---------- دیتابیس ----------
POSTGRES_PASSWORD=change_me_please

# ---------- امنیت ----------
# کلید دسترسی به API مدیریتی ماژول‌های ۱ تا ۴ (یک رشته‌ی تصادفی بلند)
API_KEY=change_me_long_random_string

# ---------- هوش مصنوعی (همه اختیاری) ----------
# ماژول ۴: پاسخ‌گویی و RAG (بدون آن فقط ارجاع به اپراتور کار می‌کند)
OPENAI_API_KEY=
OPENAI_MODEL=
# ماژول ۱: تشخیص نیت با LLM (بدون آن، قوانین کلیدواژه‌ای استفاده می‌شود)
LLM_ENABLED=false
GROQ_API_KEY=
# ماژول ۲: پیش‌نویس پیام با Claude (بدون آن، قالب ساده استفاده می‌شود)
ANTHROPIC_API_KEY=
